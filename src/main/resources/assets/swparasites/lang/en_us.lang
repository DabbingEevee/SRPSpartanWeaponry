item.infectious_long_blade_fragment.name=§eInfectious Long Blade Fragment
item.infectious_long_blade_fragment.desc=§fA piece of a quite long blade, produced from Parasite body parts. Although dangerous, it seems large enough to be used as a weapon by itself. A Component for §6Weapons§f.
item.hardened_bone_pole.name=§eHardened Bone Pole
item.hardened_bone_pole.desc=§fA particularly thick pole, composed of bones, produced from Parasites body parts. A Component for §6Weapons§f.
item.vile_plate.name=§eVile Plate
item.vile_plate.desc=§fAn extremely resilient and tough plate, produced from Parasites body parts. Although unwieldly, it seems large enough to be used as a shield by itself. A Component for §6Shields§f.
item.living_nucleus.name=§eLiving Nucleus
item.living_nucleus.desc=§fA more powerful version of the Living Core, the flame of life still has yet to shine. A Component for §6stronger Weapons§f.
item.serrated_spines.name=§eSerrated Spines
item.serrated_spines.desc=§fVery sharp spikes, made from Parasites body parts. A Component for §6Weapons§f.

